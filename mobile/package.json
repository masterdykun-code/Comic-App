{
  "name": "mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.104.4",
    "axios": "^1.20.0",
    "expo": "~57.0.30",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.22",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "lucide-react-native": "^1.59.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zod": "4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.6",
    "prettier": "^3.9.10",
    "react-test-renderer": "^19.2.3",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:smoke:feedback": "node scripts/smoke-feedback.cjs",
    "test:e2e:integration": "node ../backend/node_modules/tsx/dist/cli.mjs scripts/integration/run.cjs",
    "integration:inspect": "node ../backend/node_modules/tsx/dist/cli.mjs scripts/integration/inspect.cjs",
    "verify:backend": "node ../backend/node_modules/tsx/dist/cli.mjs scripts/integration/backend-checks.cjs",
    "export:android": "expo export --platform android",
    "export:web": "expo export --platform web --output-dir dist-web",
    "format": "prettier --write src tests e2e scripts/**/*.cjs *.js *.cjs *.json *.md",
    "format:check": "prettier --check src tests e2e scripts/**/*.cjs *.js *.cjs *.json *.md",
    "demo:inspect": "node ../backend/node_modules/tsx/dist/cli.mjs scripts/demo/cli.cjs inspect",
    "demo:seed": "node ../backend/node_modules/tsx/dist/cli.mjs scripts/demo/cli.cjs seed",
    "demo:serve": "node ../backend/node_modules/tsx/dist/cli.mjs scripts/demo/cli.cjs serve",
    "demo:cleanup": "node ../backend/node_modules/tsx/dist/cli.mjs scripts/demo/cli.cjs cleanup",
    "demo:diagnose": "node ../backend/node_modules/tsx/dist/cli.mjs scripts/demo/cli.cjs diagnose"
  },
  "private": true,
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || ^26.0.0"
  }
}
