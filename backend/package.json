{
  "name": "webnovel-backend",
  "version": "1.0.0",
  "description": "Backend API for WebNovelApp",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "demo:epub": "tsx src/scripts/epub-demo.ts",
    "dev": "tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "npm run prisma:generate && tsc --noEmit -p tsconfig.json && tsc -p tsconfig.prisma.json && tsc -p tsconfig.tests.json",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:check": "tsx src/scripts/check-db.ts",
    "db": "npm run db:check",
    "admin": "tsx src/scripts/create-admin.ts",
    "test:genres": "npm run prisma:generate && tsx --test tests/genres.test.ts",
    "test:auth": "npm run prisma:generate && tsx --test tests/auth.test.ts",
    "test:stories": "npm run prisma:generate && tsx --test tests/stories.test.ts tests/stories.db.test.ts",
    "test:chapters": "npm run prisma:generate && tsx --test tests/chapters.test.ts tests/chapters.db.test.ts",
    "test:uploads": "npm run prisma:generate && tsx --test tests/uploads.test.ts",
    "test:admin": "npm run prisma:generate && tsx --test tests/admin-bootstrap.test.ts",
    "test:reading": "npm run prisma:generate && tsx --test tests/reading.test.ts tests/reading.store.test.ts",
    "test:feedback": "npm run prisma:generate && tsx --test tests/feedback.test.ts tests/feedback.store.test.ts",
    "integration:prepare": "tsx tests/integration/run.ts prepare",
    "test:integration": "npm run prisma:generate && tsx tests/integration/run.ts test",
    "test:postgres": "npm run prisma:generate && tsx tests/integration/run.ts full",
    "test": "npm run prisma:generate && tsx --test tests/auth.test.ts tests/genres.test.ts tests/stories.test.ts tests/stories.db.test.ts tests/chapters.test.ts tests/chapters.db.test.ts tests/uploads.test.ts tests/admin-bootstrap.test.ts tests/reading.test.ts tests/reading.store.test.ts tests/feedback.test.ts tests/feedback.store.test.ts tests/integration-safety.test.ts tests/admin-catalog.test.ts tests/admin-catalog.store.test.ts tests/browser-safety.test.ts tests/epub-import.test.ts tests/bookmarks.test.ts tests/password-reset.test.ts tests/story-lifecycle.store.test.ts tests/admin-users.test.ts tests/admin-users.store.test.ts tests/coins.test.ts tests/rankings.test.ts",
    "test:admin-e2e": "npm run prisma:generate && tsx tests/browser/run.ts",
    "catalog:prepare": "node scripts/catalog/prepare.mjs",
    "catalog:inspect": "tsx src/scripts/import-sample-library.ts --inspect",
    "catalog:import": "tsx src/scripts/import-sample-library.ts",
    "test:catalog": "npm run prisma:generate && tsx --test tests/sample-library.test.ts",
    "catalog:v2:backup": "tsx src/scripts/library-expansion-db.ts --create-backup",
    "catalog:v2:dry-run": "tsx src/scripts/import-library-expansion.ts --dry-run",
    "catalog:v2:import": "tsx src/scripts/import-library-expansion.ts",
    "test:catalog:v2": "tsx --test tests/library-expansion.test.ts",
    "test:epub": "tsx --test tests/epub-import.test.ts",
    "test:bookmarks": "npm run prisma:generate && tsx --test tests/bookmarks.test.ts",
    "test:bookmarks:postgres": "npm run prisma:generate && tsx --test tests/integration/bookmarks.postgres.test.ts",
    "test:password:postgres": "npm run prisma:generate && tsx --test tests/integration/change-password.postgres.test.ts",
    "test:password-reset": "npm run prisma:generate && tsx --test tests/password-reset.test.ts",
    "test:password-reset:postgres": "npm run prisma:generate && tsx --test tests/integration/password-reset.postgres.test.ts",
    "mail:check": "tsx src/scripts/check-mail.ts",
    "test:story-lifecycle": "npm run prisma:generate && tsx --test tests/stories.test.ts tests/story-lifecycle.store.test.ts",
    "test:coins:postgres": "npm run prisma:generate && tsx --test tests/integration/coins.postgres.test.ts",
    "test:coins": "npm run prisma:generate && tsx --test tests/coins.test.ts",
    "test:rankings": "npm run prisma:generate && tsx --test tests/rankings.test.ts",
    "test:rankings:postgres": "npm run prisma:generate && tsx --test tests/integration/rankings.postgres.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@xmldom/xmldom": "^0.9.12",
    "argon2": "^0.45.1",
    "busboy": "^1.6.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^10.2.1",
    "pg": "8.23.1",
    "sharp": "^0.35.5",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "8.23.1",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "yazl": "^3.3.1"
  }
}
