PORT=4000

# Optional public origin for locally stored EPUB covers (no trailing /api).
# Use your Backend LAN origin for phone testing; restart Backend after changes.
# EPUB_PUBLIC_BASE_URL=http://YOUR_LAN_IPV4:4000

# Replace locally with your URL-encoded PostgreSQL password.
DATABASE_URL="postgresql://postgres:YOUR_URL_ENCODED_PASSWORD@localhost:5432/webnovel_db?schema=public"

# Generate locally with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never commit the generated secret or send it through chat.
JWT_SECRET="replace_with_a_random_secret_of_at_least_32_bytes"

# Copy credentials from your Cloudinary account; keep real values in .env only.
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# U09 password recovery: Gmail App Password (not your ordinary Gmail password).
# Use port 465 (TLS) or 587 (STARTTLS). Restart Backend after editing .env.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_USER="YOUR_EMAIL@gmail.com"
SMTP_PASS="YOUR_GOOGLE_APP_PASSWORD"
SMTP_FROM="YOUR_EMAIL@gmail.com"
